datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  company       String
  email         String[]
  location      String[]
  phone         String[]
  contactPerson String
  status        String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DashboardSnapshot {
  id        String   @id @default(cuid())
  title     String
  periodStart DateTime?
  periodEnd   DateTime?
  summary   String?
  createdAt DateTime @default(now())
}
